[Unit]
Description=TWork 持久异步图片适配服务
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=twork-image-adapter-async
StateDirectoryMode=0700
EnvironmentFile=/etc/twork-image-adapter-async/service.env
ExecStart=/opt/twork-image-adapter-async/current/image-adapter /etc/twork-image-adapter-async/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=300
KillSignal=SIGTERM
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
CPUQuota=200%
LimitNOFILE=4096
UMask=0077

[Install]
WantedBy=multi-user.target
