FROM node:22-bookworm-slim

WORKDIR /app

COPY probe/claude-agent/package.json probe/claude-agent/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY probe/claude-agent/tsconfig.json ./
COPY probe/claude-agent/src ./src
RUN npm run build

ENV NODE_ENV=production
EXPOSE 3021
CMD ["node", "dist/server.js"]
